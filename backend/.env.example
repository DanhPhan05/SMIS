# Server
PORT=5000
NODE_ENV=development

# Database Option 1: Supabase / Cloud PostgreSQL (Recommended for Vercel / Cloud)
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
DATABASE_URL=postgresql://postgres.xxxx:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Database Option 2: Local PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sims_db
DB_USER=postgres
DB_PASSWORD=postgres

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

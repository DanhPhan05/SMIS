# Production Environment Variables

# Node Server
PORT=5000
NODE_ENV=production

# Database (PostgreSQL inside Docker)
DB_HOST=db
DB_PORT=5432
DB_NAME=sims_db
DB_USER=postgres
DB_PASSWORD=123456

# JWT Authentication
JWT_SECRET=your_super_secure_random_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# CORS Configuration (Comma-separated allowed domains)
ALLOWED_ORIGINS=http://your-production-domain.com,https://your-production-domain.com
